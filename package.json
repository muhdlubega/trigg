{
  "name": "trigg",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "packageManager": "pnpm@10.29.3",
  "scripts": {
    "dev": "pnpm --parallel --filter @trigg/web --filter @trigg/worker dev",
    "build": "pnpm -r build",
    "deploy:web": "pnpm --filter @trigg/worker deploy:web",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "format": "prettier --write .",
    "db:migrate:local": "pnpm --filter @trigg/worker db:migrate:local",
    "db:migrate:remote": "pnpm --filter @trigg/worker db:migrate:remote"
  },
  "devDependencies": {
    "@eslint/js": "^9.35.0",
    "@types/node": "^24.3.0",
    "@typescript-eslint/eslint-plugin": "^8.41.0",
    "@typescript-eslint/parser": "^8.41.0",
    "eslint": "^9.35.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
